# Rename this file to .env and fill in your credentials.
# Make sure to add .env to your .gitignore file to keep it out of version control.

# Flask Application Secret
SECRET_KEY="your-secret-key-for-flask-sessions"

# Database Connection URL (PostgreSQL for Production / Supabase, SQLite local fallback if absent)
# Example Supabase format: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/saarthi_db"

# Google OAuth Credentials (Used for both Google Login & Google Calendar Integration)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Mail / SMTP Configuration
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"

# n8n Webhook Integration URLs
N8N_CHAT_WEBHOOK_URL="https://your-n8n-instance.com/webhook/chartbot"
N8N_BRIEF_WEBHOOK_URL="https://your-n8n-instance.com/webhook/AI"

# OAuth Development Override (Only set to 1 in local development if needed)
OAUTHLIB_INSECURE_TRANSPORT="0"